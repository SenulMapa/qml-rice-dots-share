# Pinned third-party material for tools/mac-theme. Everything is data (CSS, SVG,
# kvconfig, a tarball of prebuilt theme files); no downloaded script is ever run.
# fetch.sh refuses to continue if any sha256 differs.

# --- WhiteSur GTK (vinceliuice/WhiteSur-gtk-theme), tag 2026-09-10 --------------
# The GitHub release has no assets; the prebuilt archives live in the repo's
# release/ directory, so they are pinned by commit.
WS_GTK_TAG="2026-09-10"
WS_GTK_COMMIT="99247ecd219bdc1c7409baff062b4aafcf1102a7"
# Dark colour variant, translucent (non-"solid"), default blue accent (#0860F2),
# standard scheme (not nord), Apple start icon, stable Nautilus style.
WS_GTK_FILE="WhiteSur-Dark.tar.xz"
WS_GTK_SHA256="98ac7545ec5290b718875fdfbdd7f0f6b88126103d1eec259ec9fbf80be7b75f"
WS_GTK_NAME="WhiteSur-Dark"

# --- WhiteSur Kvantum (vinceliuice/WhiteSur-kde) --------------------------------
WS_KDE_COMMIT="cf4df59ce91004f7ea39358b1b8ff917d5c329f7"
WS_KV_THEME="WhiteSurDark"
WS_KV_CONFIG_SHA256="5987a0f360af4d7f028fe0228afef87346b26fe87c23839f6b01dc7b62cc7176"
WS_KV_SVG_SHA256="4b31c100f80efc7484485b92181d47d605df708317300f9325bc45e21fae5ff5"

# --- Browser userChrome (WhiteSur-gtk-theme other/firefox), only for --browser ---
# Source tarball of the same tag. If GitHub ever re-generates the archive and the
# sha changes, fetch.sh fails closed: re-pin after reviewing.
WS_SRC_FILE="WhiteSur-gtk-theme-2026-09-10.tar.gz"
WS_SRC_SHA256="65516c8f45da45c602471e31b4de0b6e9aed6eb3fc3820df16161d077245a1a2"
