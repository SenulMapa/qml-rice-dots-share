{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo-line-small.txt",
        "padding": {
            "top": 2,
            "right": 4,
            "left": 1
        }
    },
    "display": {
        "separator": "  ",
        "key": {
            "width": 11
        },
        "color": {
            "separator": "90"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}",
            "color": {
                "user": "magenta",
                "at": "90",
                "host": "blue"
            }
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "os",
            "key": "  distro",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": "  kernel",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "key": "  pkgs",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "󰅐  uptime",
            "keyColor": "blue"
        },
        {
            "type": "custom",
            "format": ""
        },
        {
            "type": "wm",
            "key": "  wm",
            "keyColor": "magenta"
        },
        {
            "type": "de",
            "key": "  de",
            "keyColor": "magenta"
        },
        {
            "type": "wmtheme",
            "key": "  theme",
            "keyColor": "magenta"
        },
        {
            "type": "terminal",
            "key": "  term",
            "keyColor": "magenta"
        },
        {
            "type": "terminalfont",
            "key": "  font",
            "keyColor": "magenta"
        },
        {
            "type": "shell",
            "key": "  shell",
            "keyColor": "magenta"
        },
        {
            "type": "custom",
            "format": ""
        },
        {
            "type": "cpu",
            "key": "  cpu",
            "keyColor": "cyan"
        },
        {
            "type": "gpu",
            "key": "󰢮  gpu",
            "keyColor": "cyan"
        },
        {
            "type": "memory",
            "key": "  ram",
            "keyColor": "cyan",
            "format": "{used} / {total}"
        },
        {
            "type": "disk",
            "key": "󰋊  disk",
            "keyColor": "cyan"
        },
        {
            "type": "custom",
            "format": ""
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
