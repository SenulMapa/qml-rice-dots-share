#!/usr/bin/env bash
# Generated by tools/mac-webapps/gen.sh from tools/mac-webapps/webapps.json. Do not edit.
# Shows/hides the Gemini overlay (special:webapp-gemini). Launches it when no window matches.
set -u
CLASS_RE='^(webapp-gemini|brave-gemini\.google\.com__app-.*)$'
LAUNCHER="$HOME/.local/bin/webapp-gemini"
TOGGLE='hl.dsp.workspace.toggle_special("webapp-gemini")'

has_window() {
    hyprctl clients -j 2>/dev/null | jq -e --arg re "$CLASS_RE" \
        'any(.[]; (.class // "") | test($re))' >/dev/null 2>&1
}

if ! has_window; then
    # The window rule parks the new window in special:webapp-gemini silently; wait for it, then reveal.
    "$LAUNCHER" >/dev/null 2>&1 &
    for _ in $(seq 1 100); do
        has_window && break
        sleep 0.1
    done
fi
hyprctl dispatch "$TOGGLE" >/dev/null
