#!/usr/bin/env bash
# Generated by tools/mac-webapps/gen.sh from tools/mac-webapps/webapps.json. Do not edit.
# Gemini as a Brave app window: own profile (not the main Brave profile) and class webapp-gemini.
set -eu
command -v brave >/dev/null 2>&1 || { echo "webapp-gemini: brave is not installed" >&2; exit 1; }
PROFILE="$HOME/.local/share/qml-rice/webapps/gemini"
mkdir -p "$PROFILE"
exec brave --app='https://gemini.google.com/app' --class=webapp-gemini --user-data-dir="$PROFILE" \
    --no-first-run --no-default-browser-check
